    "syntaxComment": { "dark": "fgGutter", "light": "fgGutter" },
    "syntaxKeyword": { "dark": "pink", "light": "pink" },
    "syntaxFunction": { "dark": "purple", "light": "purple" },
    "syntaxVariable": { "dark": "fg", "light": "fg" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "brRed", "light": "brRed" },
