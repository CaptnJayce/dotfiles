    "markdownHeading": { "dark": "pink", "light": "pink" },
    "markdownLink": { "dark": "brPurple", "light": "brPurple" },
    "markdownLinkText": { "dark": "purple", "light": "purple" },
    "markdownCode": { "dark": "green", "light": "green" },
