{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#0f0f1a",
    "bgDark": "#0a0a12",
    "bgBar": "#151524",
    "bgSel": "#2d2d44",
    "bgVis": "#3d3d5c",
    "fg": "#e8e8e8",
    "fgDim": "#9090a8",
    "fgGutter": "#5c5c7c",
    "red": "#dc143c",
    "green": "#57c47f",
    "rose": "#e05780",
    "purple": "#9966cc",
    "pink": "#ffb7c5",
    "brRed": "#efa0a7",
    "brGreen": "#7fd4a0",
    "brPurple": "#b090e0",
    "brPink": "#ffd0dd"
  },
  "theme": {
    "primary": { "dark": "purple", "light": "purple" },
    "secondary": { "dark": "brPurple", "light": "brPurple" },
    "accent": { "dark": "pink", "light": "pink" },
    "error": { "dark": "red", "light": "red" },
