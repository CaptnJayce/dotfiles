    "markdownEmph": { "dark": "rose", "light": "rose" },
    "markdownStrong": { "dark": "pink", "light": "pink" },
    "markdownHorizontalRule": { "dark": "bgSel", "light": "bgSel" },
    "markdownListItem": { "dark": "pink", "light": "pink" },
    "markdownListEnumeration": { "dark": "rose", "light": "rose" },
    "markdownImage": { "dark": "brPurple", "light": "brPurple" },
    "markdownImageText": { "dark": "purple", "light": "purple" },
