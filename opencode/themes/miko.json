    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "fgGutter", "light": "fgGutter" },
    "diffHunkHeader": { "dark": "fgDim", "light": "fgDim" },
    "diffHighlightAdded": { "dark": "brGreen", "light": "brGreen" },
    "diffHighlightRemoved": { "dark": "brRed", "light": "brRed" },
    "diffAddedBg": { "dark": "bgBar", "light": "bgBar" },
