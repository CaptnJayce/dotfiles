{
    "layer": "top",
    "position": "left",
    "width": 140,
    "margin-left": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "spacing": 0,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/salah", "pulseaudio", "network", "cpu", "memory", "tray"],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "sort-by-number": true
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1
        }
    },

    "cpu": {
        "format": "cpu {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "mem {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "network": {
        "format-ethernet": "{ipaddr}",
        "format-wifi": "{essid} {signalStrength}%",
        "format-disconnected": "offline",
        "tooltip-format-ethernet": "{ifname}  {ipaddr}/{cidr}",
        "tooltip-format-wifi": "{ifname}  {ipaddr}  {signalStrength}%"
    },

    "pulseaudio": {
        "format": "vol {volume}%",
        "format-muted": "muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "scroll-step": 2,
        "tooltip": false
    },

    "custom/salah": {
        "exec": "$HOME/.local/share/salah-bar/salah_bar.py --lat 51.5074 --lon -0.1278 --method MuslimWorldLeague --asr Standard",
        "interval": 30,
        "return-type": "json"
    },

    "tray": {
        "spacing": 4,
        "icon-size": 14
    }
}
