{
    "layer": "top",
    "position": "left",
    "reload_style_on_change": true,
    "width": 38,
    "margin-left": 0,
    "margin-top": 0,
    "margin-bottom": 0,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/salah", "pulseaudio", "network", "tray"],

    "hyprland/workspaces": {
        "format": "{id}",
        "sort-by-number": true
    },

    "clock": {
        "format": "{:%H\n%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "󰒢",
        "format-disconnected": "󰤯",
        "tooltip-format-wifi": "WiFi: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",
        "tooltip-format-ethernet": "Ethernet: {ifname}\nIP: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Network Disconnected",
        "max-length": 8
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": ["", "", ""],
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip": true,
        "tooltip-format": "Volume: {volume}%"
    },

    "custom/salah": {
        "exec": "$HOME/.local/share/salah-bar/salah_bar.py --lat 51.5074 --lon -0.1278 --method MuslimWorldLeague --asr Standard",
        "interval": 30,
        "return-type": "json",
        "format": "󰥹",
        "tooltip": true
    },

    "tray": {
        "spacing": 4,
        "icon-size": 14
    }
}
